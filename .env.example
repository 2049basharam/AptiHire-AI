# ==============================================================================
# APTIHIRE AI — PRODUCTION ENVIRONMENT CONFIGURATION CONTRACT
# Deployment Architecture: Vercel (Frontend/API) + Supabase (DB) + Render (Worker/Redis)
# ==============================================================================

# 1. Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session Pooler port 5432)
# Require sslmode=require in production environments
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Redis Connection URL (Upstash Redis or Render Redis with TLS rediss://)
REDIS_URL="rediss://default:[password]@[region].upstash.io:6379"

# 3. JWT Signing Key (Cryptographically secure string, MINIMUM 32 characters)
JWT_SECRET="your_high_entropy_32_plus_character_jwt_secret_key_here"

# 4. Node Environment ('development' | 'production' | 'test')
NODE_ENV="production"

# 5. AI Provider Configuration ('gemini' | 'mock' | 'test')
AI_PROVIDER_TYPE="gemini"
GEMINI_API_KEY="AIzaSyYourGoogleGeminiApiKeyHere"

# 6. Supabase Client Library Credentials
NEXT_PUBLIC_SUPABASE_URL="https://fkawcphdjdcdpkgcaeqa.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_Gnw287HuySWcoI38CyDvXg_AkejGeq2"

# 7. Production Security Safeguards (MUST NOT be set to 'true' in live production)
DISABLE_RATE_LIMIT="false"
ENABLE_TEST_ENDPOINTS="false"
